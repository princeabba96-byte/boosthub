<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Dark Material) -->
    <style name="Theme.BoostHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorBackground</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Window background and status bar -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bottomNavBackground</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Bottom navigation styling -->
        <item name="bottomNavigationStyle">@style/Widget.BoostHub.BottomNavigationView</item>
    </style>

    <!-- Splash Activity Theme -->
    <style name="Theme.BoostHub.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
    </style>

    <style name="Widget.BoostHub.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bottomNavBackground</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemRippleColor">#204A90E2</item>
        <item name="elevation">12dp</item>
    </style>
</resources>
